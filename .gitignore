# ============================================
# 通用
# ============================================
.DS_Store
*.local
*.log

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================
# 前端 (frontend/)
# ============================================
node_modules/
frontend/dist/
frontend/dist-ssr/
# `npx vite build --outDir .verify-dist` 的验证产物（改完 CSS/排版跑一遍用的）
frontend/.verify-dist/
coverage/
*.tsbuildinfo
.eslintcache
frontend/__screenshots__/
*.timestamp-*-*.mjs

# 字体子集脚本的中间产物（npm run subset-font 会重新生成）
frontend/glyph-set.txt

# ============================================
# 后端 (backend/)
# ============================================
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# 环境变量（含密钥，绝不提交）
.env
.env.*
!.env.example

# 数据库
*.sqlite3
*.db

# 上传的照片（本机开发用，线上走对象存储）
backend/media/

# 照片库（运行时数据，上传/裁剪后的照片落在这里，不属源码）
data/

# ============================================
# 其他
# ============================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
