# 后端环境变量模板
# 复制这个文件为 .env，填入真实值。.env 不会被提交到 Git。

# 应用配置
APP_NAME=lizao-site
DEBUG=true

# 数据库（db.py 在读，只认 sqlite:/// 这一种写法；相对路径相对 backend/ 解析）
# 里面是**项目页的点赞与留言**（项目正文在前端，不在这里）。
# 文件本身不提交 —— 里面的留言是真实数据，别当缓存删。
DATABASE_URL=sqlite:///./lizao.db

# 允许跨域的前端地址（逗号分隔）。走 vite 代理时用不上（同源）。
CORS_ORIGINS=http://localhost:5173

# 媒体文件存放目录
MEDIA_ROOT=./media
